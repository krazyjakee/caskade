msgid "enter your user name and web API key"
msgstr "ange ditt användarnamn och din webb-API-nyckel"

#: crates/caskade-core/src/achievements/retroachievements/mod.rs
msgid "RetroAchievements didn't accept that user name and key"
msgstr "RetroAchievements godtog inte det användarnamnet och den nyckeln"

#: crates/caskade-core/src/achievements/retroachievements/mod.rs
msgid "RetroAchievements has no game {id}"
msgstr "RetroAchievements har inget spel {id}"

#: crates/caskade-core/src/achievements/retroachievements/mod.rs
#: crates/caskade-core/src/emulation/service/games.rs
msgid "not an emulated game"
msgstr "inte ett emulerat spel"

#: crates/caskade-core/src/achievements/retroachievements/mod.rs
msgid "RetroAchievements doesn't cover this system"
msgstr "RetroAchievements täcker inte det här systemet"

#: crates/caskade-core/src/achievements/retroachievements/mod.rs
msgid "RetroAchievements identifies this system's games by a hash Caskade doesn't compute: link the game by hand"
msgstr "RetroAchievements identifierar det här systemets spel med en hash som Caskade inte beräknar: koppla spelet för hand"

#: crates/caskade-core/src/achievements/retroachievements/mod.rs
msgid "the ROM is compressed; RetroAchievements identifies what is inside: link the game by hand"
msgstr "ROM-filen är komprimerad; RetroAchievements identifierar innehållet: koppla spelet för hand"

#: crates/caskade-core/src/achievements/retroachievements/mod.rs
msgid "the ROM is too large to be a cartridge: link the game by hand"
msgstr "ROM-filen är för stor för att vara en kassett: koppla spelet för hand"

#: crates/caskade-core/src/achievements/retroachievements/mod.rs
msgid "the ROM couldn't be read: {why}"
msgstr "ROM-filen kunde inte läsas: {why}"

#: crates/caskade-core/src/achievements/retroachievements/mod.rs
msgid "RetroAchievements doesn't know this ROM (hash {hash}): another revision, region or a modified copy"
msgstr "RetroAchievements känner inte till den här ROM-filen (hash {hash}): en annan revision, region eller en ändrad kopia"

#: crates/caskade-core/src/achievements/retroachievements/mod.rs
msgid "this ROM's hash belongs to more than one RetroAchievements game: link it by hand"
msgstr "den här ROM-filens hash hör till mer än ett RetroAchievements-spel: koppla det för hand"

#: crates/caskade-core/src/achievements/retroachievements/mod.rs
msgid "the release's ROMs are different RetroAchievements games: link it by hand"
msgstr "utgåvans ROM-filer är olika RetroAchievements-spel: koppla det för hand"

