msgid "RetroAchievements didn't accept that user name and key"
msgstr "RetroAchievements godtog inte det användarnamnet och den nyckeln"

#: crates/caskade-core/src/achievements/retroachievements/mod.rs
msgid "RetroAchievements has no game {id}"
msgstr "RetroAchievements har inget spel {id}"

