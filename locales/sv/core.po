msgctxt "settings"
msgid "Rating board"
msgstr "Klassificeringsorgan"

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Windows install method"
msgstr "Installationsmetod för Windows"

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Run supported installers on Windows, or prefer extracting their files."
msgstr "Kör installationsprogram som stöds på Windows, eller extrahera hellre deras filer."

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Run the installer"
msgstr "Kör installationsprogrammet"

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Extract the files"
msgstr "Packa upp filerna"

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Execution policy"
msgstr "Körningspolicy"

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Never run installers"
msgstr "Kör aldrig installationsprogram"

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Ask first"
msgstr "Fråga först"

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Allow"
msgstr "Tillåt"

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Allow installer processes, ask before running them, or only use plans that do not execute code."
msgstr "Tillåt installationsprocesser, fråga innan de körs eller använd bara planer som inte kör kod."

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Execution policy for downloads"
msgstr "Körningspolicy för nedladdningar"

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "For games downloaded from a link (deep links, pasted or dropped URLs, magnet links and torrents, updates). The stricter of this and the execution policy applies."
msgstr "För spel som laddats ner från en länk (djuplänkar, inklistrade eller släppta URL:er, magnetlänkar och torrenter, uppdateringar). Den striktare av denna och körningspolicyn gäller."

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Ask below confidence"
msgstr "Fråga under säkerhetsnivå"

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Pause a job when its best plan scores below this probability."
msgstr "Pausa ett jobb när dess bästa plan får lägre sannolikhet än detta."

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Installer language"
msgstr "Språk för installationsprogram"

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Leave empty for the installer's default. Unsupported language switches are reported by its handler."
msgstr "Lämna tomt för installationsprogrammets standard. Språkval som inte stöds rapporteras av dess hanterare."

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Let installers create shortcuts"
msgstr "Låt installationsprogram skapa genvägar"

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Allow installer-created shortcuts where the package supports this preference."
msgstr "Tillåt genvägar som skapas av installationsprogram där paketet stöder den inställningen."

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Compatibility runner"
msgstr "Kompatibilitetslager"

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Proton uses umu. GE-Proton and Steam Proton use detected builds; system Wine uses the detected Wine executable. Applies to new jobs."
msgstr "Proton använder umu. GE-Proton och Steam Proton använder hittade versioner; systemets Wine använder det hittade Wine-programmet. Gäller nya jobb."

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Proton via umu"
msgstr "Proton via umu"

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "GE-Proton via umu"
msgstr "GE-Proton via umu"

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Steam Proton via umu"
msgstr "Steam Proton via umu"

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "System Wine"
msgstr "Systemets Wine"

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Source handling after install"
msgstr "Hantering av källan efter installation"

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Keep, move to the system trash, or delete the selected local source after a successful managed install. Downloads have their own setting."
msgstr "Behåll, flytta till papperskorgen eller radera den valda lokala källan efter en lyckad hanterad installation. Nedladdningar har en egen inställning."

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Keep source"
msgstr "Behåll källan"

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Move to trash"
msgstr "Flytta till papperskorgen"

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Delete source"
msgstr "Radera källan"

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Keep downloads"
msgstr "Behåll nedladdningar"

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Retain downloaded installers after successful installation."
msgstr "Spara nedladdade installationsprogram efter en lyckad installation."

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Concurrent downloads"
msgstr "Samtidiga nedladdningar"

#: crates/caskade-core/src/settings/schema_text.rs
