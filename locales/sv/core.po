#: crates/caskade-core/src/saves/files.rs
msgid "The save scan exceeded its file or folder limit."
msgstr "Sparskanningen överskred sin gräns för filer eller mappar."

#: crates/caskade-core/src/saves/files.rs
msgid "The network save path has no server or share."
msgstr "Nätverkssökvägen för sparfiler saknar server eller resurs."

#: crates/caskade-core/src/saves/files.rs
msgid "Save paths must resolve to an absolute location."
msgstr "Sparsökvägar måste leda till en absolut plats."

#: crates/caskade-core/src/saves/files.rs
msgid "Invalid save glob {pattern}: {error}"
msgstr "Ogiltigt sparmönster {pattern}: {error}"

#: crates/caskade-core/src/saves/registry.rs
msgid "The save scan exceeded its registry key limit."
msgstr "Sparskanningen överskred sin gräns för registernycklar."

#: crates/caskade-core/src/saves/service.rs
msgid "This release is not installed on this device."
msgstr "Den här utgåvan är inte installerad på den här enheten."

#: crates/caskade-core/src/saves/store.rs
msgid "Save settings changed elsewhere. Reload them and try again."
msgstr "Sparinställningarna ändrades på annat håll. Läs in dem igen och försök på nytt."

#: crates/caskade-core/src/saves/store.rs
msgid "The manifest game name is invalid."
msgstr "Manifestets spelnamn är ogiltigt."

#: crates/caskade-core/src/saves/store.rs
msgid "Choose at most 256 save locations."
msgstr "Välj högst 256 sparplatser."

#: crates/caskade-core/src/saves/store.rs
msgid "The save location is invalid."
msgstr "Sparplatsen är ogiltig."

#: crates/caskade-core/src/saves/store.rs
msgid "Registry save locations must start with HKEY_CURRENT_USER or HKEY_LOCAL_MACHINE."
msgstr "Sparplatser i registret måste börja med HKEY_CURRENT_USER eller HKEY_LOCAL_MACHINE."

#: crates/caskade-core/src/saves/store.rs
msgid "Choose an absolute file or folder path for saves."
msgstr "Välj en absolut sökväg till en fil eller mapp för sparfiler."

#: crates/caskade-core/src/saves/versions/blobs.rs
#: crates/caskade-core/src/saves/versions/mod.rs
msgid "A save file hasn't arrived yet."
msgstr "En sparfil har inte kommit fram än."

#: crates/caskade-core/src/saves/versions/mod.rs
msgid "This game's save folders hold too many files to keep versions of."
msgstr "Spelets sparmappar innehåller för många filer för att spara versioner av dem."

#: crates/caskade-core/src/saves/versions/mod.rs
msgid "This game's saves are too large to keep versions of."
msgstr "Spelets sparfiler är för stora för att spara versioner av dem."

#: crates/caskade-core/src/saves/versions/mod.rs
msgid "A save file changed while it was being kept. Try again once the game has closed."
msgstr "En sparfil ändrades medan den sparades. Försök igen när spelet har stängts."

#: crates/caskade-core/src/saves/versions/mod.rs
msgid "{path} has no place on this device, so it wasn't restored."
msgstr "{path} har ingen plats på den här enheten, så den återställdes inte."

#: crates/caskade-core/src/saves/versions/mod.rs
msgid "That save's files haven't arrived on this device yet."
msgstr "Sparfilerna har inte kommit fram till den här enheten än."

#: crates/caskade-core/src/saves/versions/shared.rs
msgid "This save has no files that can go on this device."
msgstr "Den här sparningen har inga filer som kan läggas på den här enheten."

#: crates/caskade-core/src/saves/versions/shared.rs
msgid "This save is too large to keep versions of."
msgstr "Den här sparningen är för stor för att spara versioner av den."

#: crates/caskade-core/src/saves/versions/shared.rs
msgid "A file of this save arrived damaged. Ask for it again."
msgstr "En fil i den här sparningen kom fram skadad. Be om den igen."

#: crates/caskade-core/src/saves/versions/store.rs
msgid "Save version {id} was not found."
msgstr "Sparversionen {id} hittades inte."

#: crates/caskade-core/src/scripts/exec.rs
msgid "“{program}” wasn't found; check that it is installed and the path is right"
msgstr "”{program}” hittades inte; kontrollera att det är installerat och att sökvägen stämmer"

#: crates/caskade-core/src/scripts/exec.rs
msgid "it didn't finish within {seconds} seconds and was stopped"
msgstr "det blev inte klart inom {seconds} sekunder och stoppades"

#: crates/caskade-core/src/scripts/mod.rs
msgid "the time limit must be 1 to {max} seconds"
msgstr "tidsgränsen måste vara 1 till {max} sekunder"

#: crates/caskade-core/src/scripts/mod.rs
msgid "choose the program the script runs"
msgstr "välj programmet som skriptet kör"

#: crates/caskade-core/src/scripts/mod.rs
msgid "a script can have at most 1024 arguments"
msgstr "ett skript kan ha högst 1024 argument"

#: crates/caskade-core/src/scripts/mod.rs
msgid "{shell} scripts can't run on this system"
msgstr "{shell}-skript kan inte köras på det här systemet"

#: crates/caskade-core/src/scripts/mod.rs
msgid "the script is empty"
msgstr "skriptet är tomt"

#: crates/caskade-core/src/scripts/mod.rs
msgid "“{name}” finished"
msgstr "”{name}” blev klart"

#: crates/caskade-core/src/scripts/mod.rs
msgid "“{name}” failed (exit code {code})"
msgstr "”{name}” misslyckades (slutkod {code})"

#: crates/caskade-core/src/scripts/mod.rs
msgid "“{name}” was stopped by a signal"
msgstr "”{name}” stoppades av en signal"

#: crates/caskade-core/src/scripts/mod.rs
msgid "“{name}” ran out of time"
msgstr "”{name}” fick slut på tid"

#: crates/caskade-core/src/scripts/mod.rs
msgid "“{name}” was cancelled"
msgstr "”{name}” avbröts"

#: crates/caskade-core/src/scripts/mod.rs
msgid "“{name}” couldn't start: {why}"
msgstr "”{name}” kunde inte starta: {why}"

#: crates/caskade-core/src/settings/mod.rs
msgid "settings store: {error}"
msgstr "inställningslagring: {error}"

#: crates/caskade-core/src/settings/mod.rs
msgid "settings JSON: {error}"
msgstr "inställnings-JSON: {error}"

#: crates/caskade-core/src/settings/mod.rs
msgid "settings registration: {why}"
msgstr "registrering av inställningar: {why}"

#: crates/caskade-core/src/settings/mod.rs
msgid "unknown settings section: {section}"
msgstr "okänd inställningssektion: {section}"

#: crates/caskade-core/src/settings/mod.rs
msgid "invalid settings for {namespace} at {paths}"
msgstr "ogiltiga inställningar för {namespace} vid {paths}"

#: crates/caskade-core/src/settings/mod.rs
msgid "settings changed concurrently; reload before saving"
msgstr "inställningarna ändrades samtidigt; läs in dem igen innan du sparar"

#: crates/caskade-core/src/settings/mod.rs
msgid "settings schema is newer than this application"
msgstr "inställningsschemat är nyare än det här programmet"

#: crates/caskade-core/src/settings/mod.rs
msgid "settings migration is unavailable"
msgstr "migrering av inställningar är inte tillgänglig"

#: crates/caskade-core/src/settings/mod.rs
msgid "stored settings envelope is invalid"
msgstr "det sparade inställningskuvertet är ogiltigt"

#: crates/caskade-core/src/settings/mod.rs
msgid "settings exceed the supported size or revision budget"
msgstr "inställningarna överskrider den tillåtna storleken eller revisionsbudgeten"

#: crates/caskade-core/src/settings/mod.rs
msgid "settings registry is unavailable"
msgstr "inställningsregistret är inte tillgängligt"

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Desktop full screen"
msgstr "Helskärm i skrivbordsläge"

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Play emulated games fullscreen in desktop mode too."
msgstr "Spela emulerade spel i helskärm även i skrivbordsläge."

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Check for game updates"
msgstr "Sök efter speluppdateringar"

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Look for new releases of games installed from GitHub in the background."
msgstr "Leta efter nya utgåvor av spel som installerats från GitHub i bakgrunden."

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Check every (hours)"
msgstr "Kontrollera var (timmar)"

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "How long to wait between checks of a game."
msgstr "Hur länge det ska dröja mellan kontrollerna av ett spel."

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Offer updates before playing"
msgstr "Erbjud uppdateringar innan du spelar"

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "When a newer release is out, ask before starting the game whether to update it first."
msgstr "När en nyare utgåva finns, fråga innan spelet startar om det ska uppdateras först."

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Check for Caskade updates"
msgstr "Sök efter Caskade-uppdateringar"

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Look for a new version of Caskade at startup and every few hours."
msgstr "Leta efter en ny version av Caskade vid start och med några timmars mellanrum."

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Fetch artwork and game info online"
msgstr "Hämta bilder och spelinformation online"

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Download Hasheous' game databases and match games to IGDB in the background, for covers, descriptions and genres."
msgstr "Ladda ner Hasheous speldatabaser och matcha spel mot IGDB i bakgrunden, för omslag, beskrivningar och genrer."

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Let other devices stream games from this one"
msgstr "Låt andra enheter streama spel från den här"

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Other devices on the local network can play this device's games."
msgstr "Andra enheter i det lokala nätverket kan spela den här enhetens spel."

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Devices added by address"
msgstr "Enheter tillagda via adress"

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Devices to stream from that aren't found on the network by themselves."
msgstr "Enheter att streama från som inte hittas i nätverket av sig själva."

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Use the streaming already set up on this device"
msgstr "Använd den streaming som redan är konfigurerad på den här enheten"

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Host through the streaming program someone already installed here, changing only Caskade's games in it."
msgstr "Var värd via streamingprogrammet som någon redan har installerat här, och ändra bara Caskades spel i det."

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Stream quality"
msgstr "Streamingkvalitet"

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "How games streamed from other devices look; each part left empty is chosen automatically."
msgstr "Hur spel som streamas från andra enheter ser ut; varje del som lämnas tom väljs automatiskt."

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Resolution"
msgstr "Upplösning"

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Width and height in pixels, like 1920x1080."
msgstr "Bredd och höjd i pixlar, som 1920x1080."

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Frame rate"
msgstr "Bildfrekvens"

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Frames per second."
msgstr "Bilder per sekund."

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Bitrate"
msgstr "Bithastighet"

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Kilobits per second."
msgstr "Kilobit per sekund."

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Save manifest URL"
msgstr "URL för sparmanifest"

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Download save-location definitions from this URL."
msgstr "Ladda ned definitioner av sparplatser från den här URL:en."

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Save versions to keep"
msgstr "Sparversioner att behålla"

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Versions kept per game; the newest stay."
msgstr "Versioner som behålls per spel; de nyaste stannar kvar."

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "What syncs"
msgstr "Vad som synkas"

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Choose Sync or This device only for each category."
msgstr "Välj Synka eller Bara den här enheten för varje kategori."

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Sync"
msgstr "Synka"

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "This device only"
msgstr "Bara den här enheten"

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Never use relays"
msgstr "Använd aldrig reläer"

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Connect to other devices only directly. A device only a relay could reach shows as offline."
msgstr "Anslut bara direkt till andra enheter. En enhet som bara ett relä kan nå visas som frånkopplad."

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Downloads from my devices"
msgstr "Nedladdningar från mina enheter"

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Get a download from another of your devices on this network when it has the same file, before the internet. Game files never go through a relay."
msgstr "Hämta en nedladdning från en annan av dina enheter i det här nätverket när den har samma fil, före internet. Spelfiler går aldrig via ett relä."

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Listening port"
msgstr "Lyssningsport"

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "A fixed UDP port for firewall rules; empty lets the system choose."
msgstr "En fast UDP-port för brandväggsregler; tomt låter systemet välja."

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Play requests from my devices"
msgstr "Spelförfrågningar från mina enheter"

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Your other devices can start a game here, as Play here would."
msgstr "Dina andra enheter kan starta ett spel här, som Spela här skulle göra."

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Accept copies from my devices"
msgstr "Ta emot kopior från mina enheter"

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "A game another of your devices sends here is copied into the default storage without asking."
msgstr "Ett spel som en annan av dina enheter skickar hit kopieras till standardlagringen utan att fråga."

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Settings kept on this device"
msgstr "Inställningar som behålls på den här enheten"

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Settings sections that stay on this device while their category syncs."
msgstr "Inställningsavsnitt som stannar på den här enheten medan deras kategori synkas."

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Rating board"
msgstr "Klassificeringsorgan"

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Windows install method"
msgstr "Installationsmetod för Windows"

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Run supported installers on Windows, or prefer extracting their files."
msgstr "Kör installationsprogram som stöds på Windows, eller extrahera hellre deras filer."

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Run the installer"
msgstr "Kör installationsprogrammet"

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Extract the files"
msgstr "Packa upp filerna"

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Running installers"
msgstr "Körning av installationsprogram"

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Never run installers"
msgstr "Kör aldrig installationsprogram"

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Ask first"
msgstr "Fråga först"

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Allow"
msgstr "Tillåt"

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Let installers run, ask before each one, or only install games that need no installer program."
msgstr "Låt installationsprogram köras, fråga före vart och ett, eller installera bara spel som inte behöver något installationsprogram."

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Running installers from downloads"
msgstr "Körning av installationsprogram från nedladdningar"

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "For games downloaded from a link (deep links, pasted or dropped addresses, magnet links and torrents, updates). The stricter of this and Running installers applies."
msgstr "För spel som laddas ner från en länk (djuplänkar, inklistrade eller släppta adresser, magnetlänkar och torrenter, uppdateringar). Den striktare av den här inställningen och Körning av installationsprogram gäller."

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Ask when less sure than"
msgstr "Fråga vid lägre säkerhet än"

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Ask before installing when Caskade is less sure than this of how a game installs."
msgstr "Fråga innan installation när Caskade är mindre säker än så här på hur ett spel installeras."

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Installer language"
msgstr "Språk för installationsprogram"

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Leave empty for the installer's default. Caskade says when an installer can't switch language."
msgstr "Lämna tomt för installationsprogrammets standard. Caskade säger till när ett installationsprogram inte kan byta språk."

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Let installers create shortcuts"
msgstr "Låt installationsprogram skapa genvägar"

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Let installers add their own shortcuts, where they offer the choice."
msgstr "Låt installationsprogram lägga till sina egna genvägar, där de erbjuder valet."

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Compatibility runner"
msgstr "Kompatibilitetslager"

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Proton uses umu. GE-Proton and Steam Proton use detected builds; system Wine uses the detected Wine executable. Applies to installs started after a change."
msgstr "Proton använder umu. GE-Proton och Steam Proton använder identifierade versioner; system-Wine använder den identifierade körbara Wine-filen. Gäller installationer som startas efter en ändring."

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Proton via umu"
msgstr "Proton via umu"

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "GE-Proton via umu"
msgstr "GE-Proton via umu"

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Steam Proton via umu"
msgstr "Steam Proton via umu"

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "System Wine"
msgstr "Systemets Wine"

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "After installing from a file"
msgstr "Efter installation från en fil"

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Keep the file you installed from, move it to the system trash, or delete it. Downloads have their own setting."
msgstr "Behåll filen du installerade från, flytta den till systemets papperskorg eller radera den. Nedladdningar har en egen inställning."

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Keep the file"
msgstr "Behåll filen"

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Move to trash"
msgstr "Flytta till papperskorgen"

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Delete the file"
msgstr "Radera filen"

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Keep downloads"
msgstr "Behåll nedladdningar"

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Retain downloaded installers after successful installation."
msgstr "Spara nedladdade installationsprogram efter en lyckad installation."

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Concurrent downloads"
msgstr "Samtidiga nedladdningar"

#: crates/caskade-core/src/settings/schema_text.rs
msgctxt "settings"
msgid "Maximum simultaneous downloads. Active downloads finish when this limit is lowered."
msgstr "Högsta antal samtidiga nedladdningar. Pågående nedladdningar slutförs när gränsen sänks."

#: crates/caskade-core/src/share/items.rs
msgid "saves aren't available"
msgstr "sparningar är inte tillgängliga"

#: crates/caskade-core/src/share/items.rs
msgid "that save isn't here any more"
msgstr "den sparningen finns inte här längre"

#: crates/caskade-core/src/share/items.rs
msgid "that save's files haven't all arrived on this device"
msgstr "alla filer i den sparningen har inte kommit fram till den här enheten"

#: crates/caskade-core/src/share/items.rs
msgid "that save's files are only where this device keeps them, so they can't go elsewhere"
msgstr "den sparningens filer finns bara där den här enheten har dem, så de kan inte flyttas någon annanstans"

#: crates/caskade-core/src/share/items.rs
msgid "that isn't a web game"
msgstr "det är inte ett webbspel"

#: crates/caskade-core/src/share/items.rs
msgid "save it for offline play first: only an offline copy can be shared"
msgstr "spara det för spel utan uppkoppling först: bara en offlinekopia kan delas"

#: crates/caskade-core/src/share/items.rs
#: crates/caskade-core/src/transfer/mod.rs
msgid "the game's storage isn't available"
msgstr "spelets lagring är inte tillgänglig"

#: crates/caskade-core/src/share/items.rs
msgid "the offline copy's files aren't there"
msgstr "offlinekopians filer finns inte där"

#: crates/caskade-core/src/share/items.rs
#: crates/caskade-core/src/transfer/rom.rs
msgid "this share's description is damaged"
msgstr "den här delningens beskrivning är skadad"

#: crates/caskade-core/src/share/items.rs
#: crates/caskade-core/src/share/mod.rs
msgid "this share has no game"
msgstr "den här delningen har inget spel"

#: crates/caskade-core/src/share/items.rs
msgid "a file of that save isn't on this device any more"
