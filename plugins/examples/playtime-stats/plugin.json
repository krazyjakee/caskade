{
  "$schema": "https://caskade.dev/schemas/plugin.json",
  "id": "dev.caskade.playtime-stats",
  "name": "Playtime stats",
  "version": "0.2.0",
  "api": "^0.2",
  "description": "Where your playtime goes: your most played games, and your last session.",
  "author": "Caskade",
  "backend": "dist/backend.wasm",
  "permissions": {
    "library": "read"
  },
  "activation": ["onView:stats", "onEvent:game.exited"],
  "contributes": {
    "views": [{ "id": "stats", "title": "Playtime stats", "modes": ["desktop", "console"] }],
    "hooks": ["game.exited"]
  }
}
