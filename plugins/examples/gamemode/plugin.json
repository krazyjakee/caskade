{
  "$schema": "https://caskade.dev/schemas/plugin.json",
  "id": "dev.caskade.gamemode",
  "name": "GameMode",
  "version": "0.1.0",
  "api": "^0.1",
  "description": "Runs games through Feral GameMode's gamemoderun on Linux, when it is installed.",
  "author": "Caskade",
  "backend": "dist/backend.wasm",
  "permissions": {
    "process": true,
    "fs": ["/usr/bin:ro", "/usr/games:ro", "/usr/local/bin:ro"]
  },
  "contributes": {
    "hooks": ["launch.before"],
    "settings": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "title": "Run games with GameMode",
          "default": true
        },
        "command": {
          "type": "string",
          "title": "gamemoderun path",
          "description": "Empty looks in /usr/bin, /usr/games and /usr/local/bin.",
          "default": ""
        }
      },
      "additionalProperties": false
    }
  }
}
