{
  "$schema": "https://caskade.dev/schemas/plugin.json",
  "id": "dev.caskade.example.pack",
  "name": "Caskade Pack (example)",
  "version": "0.3.0",
  "description": "Installs .cpk game packs and finds them on download pages.",
  "api": "^0.2",
  "backend": "dist/backend.wasm",
  "permissions": {
    "network": ["games.example.com"]
  },
  "contributes": {
    "providers": ["install-handler", "url-resolver"],
    "slots": [{ "slot": "game.actions", "id": "about-packs", "title": "About game packs" }],
    "settings": {
      "type": "object",
      "title": "Game packs",
      "properties": {
        "preferPacks": {
          "type": "boolean",
          "title": "Prefer packs",
          "description": "Rank a pack's own install plan above the built-in installers.",
          "default": true
        }
      },
      "additionalProperties": false
    }
  }
}
