{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Caskade",
  "version": "0.1.0",
  "identifier": "dev.caskade.app",
  "build": {
    "beforeDevCommand": "python3 ../../scripts/tauri-sidecar.py && pnpm vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "python3 ../../scripts/tauri-sidecar.py && pnpm vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Caskade",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' caskade-plugin: http://caskade-plugin.localhost; img-src 'self' data: https://images.igdb.com https://i.ytimg.com caskade-asset: http://caskade-asset.localhost caskade-plugin: http://caskade-plugin.localhost caskade-theme: http://caskade-theme.localhost; style-src 'self' 'unsafe-inline' caskade-plugin: http://caskade-plugin.localhost caskade-theme: http://caskade-theme.localhost; font-src 'self' data: caskade-plugin: http://caskade-plugin.localhost caskade-theme: http://caskade-theme.localhost; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "externalBin": ["binaries/7zz"],
    "resources": {
      "binaries/7zip-License.txt": "licenses/7zip-License.txt"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["caskade"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU4MDI1QjVGRDlERjdBNTgKUldSWWV0L1pYMXNDV05xNkwrSHhpaGN1NTdwdHV6MjQxQ0FhY1JJSU1uc3orRzN3NEdoVHhKVEEK",
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
