[Desktop Entry]
Type=Application
Name={{name}}
{{#if comment}}
Comment={{comment}}
{{/if}}
Comment[sv]=Spelbibliotek och spelstartare
Exec=caskade %u
Icon={{icon}}
Terminal=false
Categories={{categories}}
Keywords=game;launcher;library;emulator;rom;streaming;steam;gog;epic;
StartupNotify=true
StartupWMClass=caskade
MimeType=x-scheme-handler/caskade;
