    "Step": {
      "description": "Fixed plan DSL: analysis describes operations; only the executor acts on them.\n\nAll `to`, `expect`, `target_dir`, `path` and `mount_point` paths are relative\nto staging/the final game directory. Symlink targets are relative to the\nlink's parent and must resolve inside the game tree. The executor validates\nthese invariants through the safety layer before performing any operation.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "extract"
            },
            "value": {
              "type": "object",
              "properties": {
                "from": {
                  "$ref": "#/$defs/ArtifactId"
                },
                "select": {
                  "description": "Include globs; empty selects every entry.",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "strip": {
                  "description": "Optional prefix removed before writing selected entries.",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "to": {
                  "type": "string"
                }
              },
              "required": [
                "from",
                "select",
                "to"
              ]
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "copy"
            },
            "value": {
              "type": "object",
              "properties": {
                "from": {
                  "$ref": "#/$defs/SourcePath"
                },
                "to": {
                  "type": "string"
                }
              },
              "required": [
                "from",
                "to"
              ]
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "move"
            },
            "value": {
              "type": "object",
              "properties": {
                "from": {
                  "$ref": "#/$defs/SourcePath"
                },
                "to": {
                  "type": "string"
                }
              },
              "required": [
                "from",
                "to"
              ]
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "run"
            },
            "value": {
              "type": "object",
              "properties": {
                "args": {
                  "description": "Argument vector; never interpreted by a shell.",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "env": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "expect": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "program": {
                  "$ref": "#/$defs/Program"
                },
                "runtime": {
                  "$ref": "#/$defs/RuntimeSpec"
                },
                "timeout_secs": {
                  "description": "Wall-clock limit in seconds; must be non-zero before execution.",
                  "type": "integer",
                  "format": "uint64",
                  "minimum": 0
                }
              },
              "required": [
                "program",
                "args",
                "env",
                "runtime",
                "timeout_secs",
                "expect"
              ]
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "run_interactive"
            },
            "value": {
              "type": "object",
              "properties": {
