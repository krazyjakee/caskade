        },
        {
          "description": "Writes `length` bytes of a file artifact, from `offset`, to `path`:\nhow a plugin `install-handler` unpacks a container format it knows\nwithout writing files itself (#55).",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "copy_range"
            },
            "value": {
              "type": "object",
              "properties": {
                "from": {
                  "$ref": "#/$defs/ArtifactId"
                },
                "length": {
                  "type": "integer",
                  "format": "uint64",
                  "minimum": 0
                },
                "offset": {
                  "type": "integer",
                  "format": "uint64",
                  "minimum": 0
                },
                "path": {
                  "type": "string"
                }
              },
              "required": [
