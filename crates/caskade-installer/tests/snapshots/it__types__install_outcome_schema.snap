                "offset",
                "length",
                "path"
              ]
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "registry_import"
            },
            "value": {
              "type": "object",
              "properties": {
                "entries": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/RegistryEntry"
                  }
                },
                "runtime": {
                  "description": "Execution rejects Native; registry replay only targets prefixes.",
                  "$ref": "#/$defs/RuntimeSpec"
                }
              },
              "required": [
                "runtime",
                "entries"
              ]
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "delegate"
            },
            "value": {
              "type": "object",
              "properties": {
                "args": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "only_if": {
                  "description": "Runs first; the step is skipped unless it exits 0.",
                  "anyOf": [
                    {
                      "$ref": "#/$defs/DelegateCheck"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "tool": {
                  "type": "string"
                },
                "uninstall": {
                  "description": "Required compensation recorded for uninstall and rollback.",
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/DelegateCommand"
                  }
                }
              },
              "required": [
                "tool",
                "args",
                "uninstall"
              ]
            }
          },
          "required": [
            "type",
            "value"
          ]
        }
      ]
    },
    "Strategy": {
      "type": "string",
      "enum": [
        "copy",
        "extract",
        "run_silent",
        "run_interactive",
        "delegate",
        "hand_off"
      ]
    },
    "Warning": {
      "description": "Nonfatal, machine-readable diagnostic with human-readable context.",
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "path": {
          "description": "When present, relative to the game directory.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "code",
        "message"
      ]
    }
