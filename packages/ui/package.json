    "docs": "node scripts/docs.ts"
  },
  "peerDependencies": {
    "@lingui/core": "^6",
    "@lingui/react": "^6",
    "lucide-react": "^1",
    "react": "^19",
    "react-aria-components": "^1",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@lingui/core": "^6.10.1",
    "@lingui/react": "^6.10.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@caskade/i18n": "workspace:*"
