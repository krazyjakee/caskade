{
  "name": "@caskade/ui",
  "version": "0.1.0",
  "description": "Caskade's themeable components on React Aria, with the anatomy catalogue themes and plugins target (data-cs, data-part, data-status).",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
