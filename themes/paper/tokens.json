{
  "$description": "Paper overrides the contract's semantic and component tokens (docs/theming/tokens.md). It leaves alone the tokens that Appearance and console mode change through override sets (density.scale, type.scale, motion durations and stagger, focus.ring.width, offset, inner and halo, card.width, hero.height): a theme's tokens sit in a later layer and would win over the user's settings. Glow strength 0 keeps focus a crisp ink edge (focus.ring.glow) without the inward glow or halo, in both modes (#161). Text colours meet WCAG AA (4.5:1) and border.strong 3:1 on every surface (#200).",
  "font": {
    "$type": "fontFamily",
    "display": {
      "$value": ["Source Serif 4 Variable", "Georgia", "Times New Roman", "serif"]
    }
  },
  "color": {
    "$type": "color",
    "surface": {
      "base": { "$value": "#f3eee3" },
      "raised": { "$value": "#fbf8f1" },
      "overlay": { "$value": "#fffdf8" },
      "hover": { "$value": "#e9e1cf" }
    },
    "border": {
      "$root": { "$value": "#2b251833" },
      "strong": { "$value": "#2b251887" }
    },
    "fg": {
      "$root": { "$value": "#1f1b14" },
      "muted": { "$value": "#4d4537" },
      "subtle": { "$value": "#675d4c" }
    },
    "accent": {
      "$root": { "$value": "#a33224" },
      "strong": { "$value": "#842518" },
      "alt": { "$value": "#1f4a73" },
      "fg": { "$value": "#fffdf8" }
    },
    "glow": { "$value": "#00000000" },
    "status": {
      "installed": { "$value": "#2a6640" },
      "available": { "$value": "#8f4c0e" },
      "emulated": { "$value": "#55458f" },
      "missing": { "$value": "#5f584a" }
    },
    "warning": { "$value": "#7f5508" },
    "danger": { "$value": "#a8241c" }
  },
  "radius": {
    "$type": "dimension",
    "card": { "$value": "0" },
    "control": { "$value": "0" },
    "panel": { "$value": "0" }
  },
  "effect": {
    "glass": { "blur": { "$value": "0px" } },
    "grid": { "opacity": { "$value": 0 } },
    "scanline": { "opacity": { "$value": 0 } },
    "glow": { "strength": { "$value": 0 } }
  },
  "motion": {
    "ease": { "out": { "$value": [0.25, 0.1, 0.25, 1] } }
  },
  "focus": {
    "ring": { "glow": { "$value": "{color.accent.alt}" } }
  },
  "sidebar": { "width": { "$value": "14rem" } },
  "topbar": { "height": { "$value": "4rem" } },
  "card": { "aspect": { "$value": "3 / 2" } },
  "chamfer": { "$value": "0px" }
}
