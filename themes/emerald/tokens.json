{
  "$description": "Emerald restyles caskade.default (#125). It turns the HUD off (grid, scanlines, chamfers and frame corners) and leaves alone the tokens Appearance and console mode change. Text colours meet WCAG AA (4.5:1) on every surface; the accent carries dark text (7.3:1).",
  "font": {
    "$type": "fontFamily",
    "display": {
      "$value": [
        "Barlow Semi Condensed",
        "Inter Variable",
        "ui-sans-serif",
        "system-ui",
        "sans-serif"
      ]
    }
  },
  "color": {
    "$type": "color",
    "surface": {
      "base": {
        "$value": "#0b0d0c"
      },
      "raised": {
        "$value": "#141816e6"
      },
      "overlay": {
        "$value": "#1a1f1c"
      },
      "hover": {
        "$value": "#232a26"
      }
    },
    "border": {
      "$root": {
        "$value": "#c8ffd91a"
      },
      "strong": {
        "$value": "#c8ffd938"
      }
    },
    "fg": {
      "$root": {
        "$value": "#f1f5f2"
      },
      "muted": {
        "$value": "#b6c1ba"
      },
      "subtle": {
        "$value": "#909d95"
      }
    },
    "accent": {
      "$root": {
        "$value": "#19b85f"
      },
      "strong": {
        "$value": "#12924a"
      },
      "alt": {
        "$value": "#7cf2a7"
      },
      "fg": {
        "$value": "#03140a"
      }
    },
    "glow": {
      "$value": "#2fe07a59"
    },
    "status": {
      "installed": {
        "$value": "#3fd67f"
      },
      "available": {
        "$value": "#ffab4a"
      },
      "emulated": {
        "$value": "#b29bff"
      },
      "missing": {
        "$value": "#8c9890"
      }
    },
    "warning": {
      "$value": "#f5c04a"
    },
    "danger": {
      "$value": "#ff6670"
    }
  },
  "radius": {
    "$type": "dimension",
    "card": {
      "$value": "2px"
    },
    "control": {
      "$value": "2px"
    },
    "panel": {
      "$value": "4px"
    }
  },
  "effect": {
    "grid": {
      "opacity": {
        "$value": 0
      }
    },
    "scanline": {
      "opacity": {
        "$value": 0
      }
    },
    "glow": {
      "strength": {
        "$value": 0.6
      }
    }
  },
  "focus": {
    "ring": {
      "glow": {
        "$value": "{color.accent.alt}"
      }
    }
  },
  "chamfer": {
    "$value": "0px"
  },
  "frame": {
    "corner": {
      "$value": "0px"
    }
  }
}
