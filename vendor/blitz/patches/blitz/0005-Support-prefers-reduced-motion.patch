From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jake Cattrall <krazyjakee@gmail.com>
Date: Tue, 10 Nov 2026 03:09:24 +0000
Subject: [PATCH] Support prefers-reduced-motion

`Viewport::prefers_reduced_motion` carries the user's setting into Stylo's
device (with the matching Stylo patch adding the media feature), and a
change re-evaluates media queries and recascades. winit doesn't report the
system setting: the embedder sets it on the document (`viewport_mut()`),
before or after the window opens, and the shell keeps it;
`BLITZ_PREFERS_REDUCED_MOTION=1` forces it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 packages/blitz-dom/src/document.rs     | 2 +-
 packages/blitz-dom/src/stylo_device.rs | 6 ++++++
 packages/blitz-shell/src/window.rs     | 7 ++++++-
 packages/blitz-traits/src/shell.rs     | 4 ++++
 4 files changed, 17 insertions(+), 2 deletions(-)

diff --git a/packages/blitz-dom/src/document.rs b/packages/blitz-dom/src/document.rs
index 79bbfe68..97c8739f 100644
--- a/packages/blitz-dom/src/document.rs
+++ b/packages/blitz-dom/src/document.rs
@@ -2268,7 +2268,7 @@ impl BaseDocument {
         // Color-scheme changes affect values that are resolved at cascade time
         // (`light-dark()`, system colors) without necessarily flipping any
         // media query result, so conservatively recascade the whole tree.
-        if changes.contains(DeviceChanges::COLOR_SCHEME) {
+        if changes.intersects(DeviceChanges::COLOR_SCHEME | DeviceChanges::REDUCED_MOTION) {
             if let Some(root_id) = self.try_root_element().map(|el| el.id) {
                 self.nodes[root_id].set_restyle_hint(RestyleHint::recascade_subtree());
             }
diff --git a/packages/blitz-dom/src/stylo_device.rs b/packages/blitz-dom/src/stylo_device.rs
index a6e1c021..2207d07e 100644
--- a/packages/blitz-dom/src/stylo_device.rs
+++ b/packages/blitz-dom/src/stylo_device.rs
@@ -39,6 +39,8 @@ bitflags! {
         const COLOR_SCHEME = 0b0000_0100;
         /// The media type (e.g. screen/print) changed.
         const MEDIA_TYPE = 0b0000_1000;
+        /// The reduced-motion preference changed.
+        const REDUCED_MOTION = 0b0001_0000;
     }
 }
 
@@ -56,6 +58,9 @@ impl DeviceChanges {
         if old.color_scheme != new.color_scheme {
             changes |= Self::COLOR_SCHEME;
         }
+        if old.prefers_reduced_motion != new.prefers_reduced_motion {
+            changes |= Self::REDUCED_MOTION;
+        }
         changes
     }
 }
@@ -83,6 +88,7 @@ pub(crate) fn make_device(
                 ColorScheme::Light => PrefersColorScheme::Light,
                 ColorScheme::Dark => PrefersColorScheme::Dark,
             },
+            prefers_reduced_motion: viewport.prefers_reduced_motion,
             primary_pointer_capabilities: PointerCapabilities::default(),
             all_pointer_capabilities: PointerCapabilities::default(),
         },
diff --git a/packages/blitz-shell/src/window.rs b/packages/blitz-shell/src/window.rs
index a649a61d..3ac5c537 100644
--- a/packages/blitz-shell/src/window.rs
+++ b/packages/blitz-shell/src/window.rs
@@ -200,7 +200,7 @@ impl<Rend: WindowRenderer> View<Rend> {
         let viewport_height = size
             .height
             .saturating_sub(safe_area_insets.top + safe_area_insets.bottom);
-        let viewport = Viewport::new(viewport_width, viewport_height, scale, color_scheme);
+        let mut viewport = Viewport::new(viewport_width, viewport_height, scale, color_scheme);
 
         // Create shell provider
         let shell_provider =
@@ -208,6 +208,11 @@ impl<Rend: WindowRenderer> View<Rend> {
 
         let mut doc = config.doc;
         let mut inner = doc.inner_mut();
+        // winit doesn't report the system's reduced-motion setting: the
+        // embedder sets it on the document (`viewport_mut()`), before or after
+        // the window opens; `BLITZ_PREFERS_REDUCED_MOTION=1` forces it.
+        viewport.prefers_reduced_motion = inner.viewport().prefers_reduced_motion
+            || std::env::var("BLITZ_PREFERS_REDUCED_MOTION").is_ok_and(|v| v == "1");
         inner.set_viewport(viewport);
         inner.set_shell_provider(Arc::new(shell_provider));
 
diff --git a/packages/blitz-traits/src/shell.rs b/packages/blitz-traits/src/shell.rs
index f92d7326..9cd1e904 100644
--- a/packages/blitz-traits/src/shell.rs
+++ b/packages/blitz-traits/src/shell.rs
@@ -86,6 +86,8 @@ pub struct Viewport {
     pub window_size: (u32, u32),
     pub hidpi_scale: f32,
     pub zoom: f32,
+    /// The user asked for reduced motion (`prefers-reduced-motion: reduce`).
+    pub prefers_reduced_motion: bool,
 }
 
 impl Default for Viewport {
@@ -95,6 +97,7 @@ impl Default for Viewport {
             hidpi_scale: 1.0,
             zoom: 1.0,
             color_scheme: ColorScheme::Light,
+            prefers_reduced_motion: false,
         }
     }
 }
@@ -111,6 +114,7 @@ impl Viewport {
             hidpi_scale: scale_factor,
             zoom: 1.0,
             color_scheme,
+            prefers_reduced_motion: false,
         }
     }
 
