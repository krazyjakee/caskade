+            scroll_x,
+            scroll_y,
             &mut dispatch_event,
         ),
-        BlitzWheelDelta::Pixels(x, y) => {
-            doc.scroll_chain_by(doc.get_hover_node_id(), x, y, &mut dispatch_event)
+        BlitzWheelDelta::Pixels(..) => {
+            doc.scroll_chain_by(doc.get_hover_node_id(), scroll_x, scroll_y, &mut dispatch_event)
         }
     };
     if has_changed {
