From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: caskade <caskade@localhost>
Date: Tue, 10 Nov 2026 10:36:48 +0000
Subject: [PATCH] Mount a Dioxus app in a div, not a main element

DioxusDocument put the app in `<main id="main">` (its comment says
`<div id="main">`), so every app's accessibility tree started with a main
landmark around the app's own landmarks, and screen readers announced
two main regions. The mount point is now the `<div>` the comment
describes; it has no styles of its own either way.
---
 packages/dioxus-native-dom/src/dioxus_document.rs | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/packages/dioxus-native-dom/src/dioxus_document.rs b/packages/dioxus-native-dom/src/dioxus_document.rs
index 306e83dd..cc897a88 100644
--- a/packages/dioxus-native-dom/src/dioxus_document.rs
+++ b/packages/dioxus-native-dom/src/dioxus_document.rs
@@ -122,7 +122,9 @@ impl DioxusDocument {
             name: qual_name("id", None),
             value: "main".to_string(),
         };
-        let main_element_id = mutr.create_element(qual_name("main", None), vec![main_attr]);
+        // A `<div>`, not a `<main>`: the app's own landmarks are its own, and
+        // a screen reader would announce a second main region around them.
+        let main_element_id = mutr.create_element(qual_name("div", None), vec![main_attr]);
         mutr.append_children(body_element_id, &[main_element_id]);
 
         drop(mutr);
@@ -405,7 +407,7 @@ mod tests {
             doc.poll(None);
         }
 
-        // The `<main>` element should end up with exactly one keyed `div` per
+        // The `<div id="main">` element should end up with exactly one keyed `div` per
         // inserted item, and applying the mutations must not have panicked.
         let inner = doc.inner.borrow();
         let main = inner.get_node(doc.main_element_id).unwrap();
