From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: caskade <caskade@localhost>
Date: Tue, 10 Nov 2026 11:01:22 +0000
Subject: [PATCH] Name the AccessKit window after the window's title

The tree's window node had no name, so screen readers announced the window
as "frame" alone. The shell now names it when it sends the tree: the
document's `<title>`, or else the title the window was created with (winit
can't read a window's title back on X11 or Wayland).
---
 packages/blitz-shell/src/accessibility.rs | 30 ++++++++++++++++++++---
 packages/blitz-shell/src/window.rs        | 12 ++++++---
 2 files changed, 35 insertions(+), 7 deletions(-)

diff --git a/packages/blitz-shell/src/accessibility.rs b/packages/blitz-shell/src/accessibility.rs
index d9f58769..27cb9945 100644
--- a/packages/blitz-shell/src/accessibility.rs
+++ b/packages/blitz-shell/src/accessibility.rs
@@ -14,6 +14,9 @@ use winit::{
 pub struct AccessibilityState {
     // /// Adapter to connect to the [`EventLoop`](`winit::event_loop::EventLoop`).
     adapter: Adapter,
+    /// The title the window was created with: winit can't read a window's
+    /// title back on X11 or Wayland.
+    pub(crate) window_title: String,
 }
 
 struct Handler {
@@ -40,12 +43,31 @@ impl AccessibilityState {
                 window.window_handle().unwrap().as_raw(),
                 Arc::new(Handler { window_id, proxy }),
             ),
+            window_title: String::new(),
         }
     }
-    pub fn update_tree(&mut self, doc: &BaseDocument) {
-        let _ = doc;
-        self.adapter
-            .update_if_active(|| doc.build_accessibility_tree());
+    /// Sends the document's tree, its window node named after the window:
+    /// the document's `<title>`, or the title the window was created with.
+    pub fn update_tree(&mut self, doc: &BaseDocument, window: &dyn Window) {
+        let window_title = &self.window_title;
+        self.adapter.update_if_active(|| {
+            let mut update = doc.build_accessibility_tree();
+            let title = doc
+                .find_title_node()
+                .map(|node| node.text_content())
+                .filter(|title| !title.is_empty())
+                .or_else(|| (!window_title.is_empty()).then(|| window_title.clone()))
+                .unwrap_or_else(|| window.title());
+            if !title.is_empty()
+                && let Some((_, root)) = update
+                    .nodes
+                    .iter_mut()
+                    .find(|(id, _)| *id == NodeId(u64::MAX))
+            {
+                root.set_label(title);
+            }
+            update
+        });
     }
 
     /// Allows reacting to window events.
diff --git a/packages/blitz-shell/src/window.rs b/packages/blitz-shell/src/window.rs
index 3ac5c537..efb919ea 100644
--- a/packages/blitz-shell/src/window.rs
+++ b/packages/blitz-shell/src/window.rs
@@ -157,11 +157,17 @@ impl<Rend: WindowRenderer> View<Rend> {
         // seed the viewport on platforms (winit-web) that report `surface_size() == 0×0`
         // until a layout pass fires.
         let requested_surface_size = config.attributes.surface_size;
+        #[cfg(feature = "accessibility")]
+        let window_title = config.attributes.title.clone();
         let attrs = config.attributes.with_visible(false);
 
         let winit_window: Arc<dyn Window> = Arc::from(event_loop.create_window(attrs).unwrap());
         #[cfg(feature = "accessibility")]
-        let accessibility = AccessibilityState::new(&*winit_window, proxy.clone());
+        let mut accessibility = AccessibilityState::new(&*winit_window, proxy.clone());
+        #[cfg(feature = "accessibility")]
+        {
+            accessibility.window_title = window_title;
+        }
 
         if is_visible {
             winit_window.set_visible(true);
@@ -451,7 +457,7 @@ impl<Rend: WindowRenderer> View<Rend> {
         // DOM, styles, layout and focus.
         if !is_blocked && inner.has_changes() {
             #[cfg(feature = "accessibility")]
-            self.accessibility.update_tree(&inner);
+            self.accessibility.update_tree(&inner, &*self.window);
             inner.clear_changes();
         }
 
@@ -604,7 +610,7 @@ impl<Rend: WindowRenderer> View<Rend> {
     #[cfg(feature = "accessibility")]
     pub fn build_accessibility_tree(&mut self) {
         let inner = self.doc.inner();
-        self.accessibility.update_tree(&inner);
+        self.accessibility.update_tree(&inner, &*self.window);
     }
 
     #[cfg(target_arch = "wasm32")]
