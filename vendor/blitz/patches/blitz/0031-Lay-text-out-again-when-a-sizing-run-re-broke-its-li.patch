From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: caskade <caskade@localhost>
Date: Sat, 14 Nov 2026 21:09:29 +0000
Subject: [PATCH] Lay text out again when a sizing run re-broke its lines

Inline layout breaks a paragraph's lines on every run that computes its
height, sizing runs (`RunMode::ComputeSize`) included, and paint draws
the lines as last broken. When a later `RunMode::PerformLayout` hit the
layout cache, nothing broke the lines again at the final width: after an
edit elsewhere re-measured a grid track, paragraphs and labels were drawn
wrapped at their min-content width inside boxes laid out for their full
width, overflowing onto what followed.

A sizing run that breaks lines now marks the node and its layout
ancestors' cached final layouts stale; a stale final layout misses the
cache, and storing a new one clears the mark.
---
 .../blitz-dom/src/layout/inline/layout.rs     | 19 +++++++++++++++++++
 packages/blitz-dom/src/layout/mod.rs          | 17 ++++++++++-------
 packages/blitz-dom/src/node/element.rs        |  5 +++++
 3 files changed, 34 insertions(+), 7 deletions(-)

diff --git a/packages/blitz-dom/src/layout/inline/layout.rs b/packages/blitz-dom/src/layout/inline/layout.rs
index ae321a04d..28492dcf5 100644
--- a/packages/blitz-dom/src/layout/inline/layout.rs
+++ b/packages/blitz-dom/src/layout/inline/layout.rs
@@ -191,6 +191,19 @@ impl LayoutPassState<'_> {
         }
     }
 
+    /// Mark the cached `PerformLayout` results of `node_id` and its layout ancestors stale,
+    /// so the next layout pass lays them out again rather than reusing them.
+    fn mark_final_layout_stale(&mut self, node_id: NodeId) {
+        let mut current = Some(node_id);
+        while let Some(id) = current {
+            let node = &mut self.nodes[id];
+            current = node.layout_parent.get().or(node.parent);
+            if let Some(layout_data) = node.try_layout_data_mut() {
+                layout_data.final_layout_stale = true;
+            }
+        }
+    }
+
     pub(crate) fn compute_inline_layout(
         &mut self,
         node_id: NodeId,
@@ -1375,6 +1388,12 @@ impl LayoutPassState<'_> {
             .unwrap()
             .inline_layout_data = Some(inline_layout);
 
+        // A sizing run broke the lines at the width it measured: this node's cached layout,
+        // and its ancestors', no longer match what paint would draw.
+        if inputs.run_mode != RunMode::PerformLayout {
+            self.mark_final_layout_stale(node_id);
+        }
+
         let oof_position_inset = taffy::Rect {
             left: border.left,
             right: border.right + scrollbar_gutter.x,
diff --git a/packages/blitz-dom/src/layout/mod.rs b/packages/blitz-dom/src/layout/mod.rs
index 370c2251c..e0bf4ea2b 100644
--- a/packages/blitz-dom/src/layout/mod.rs
+++ b/packages/blitz-dom/src/layout/mod.rs
@@ -748,10 +748,11 @@ impl taffy::CacheTree for LayoutPassState<'_> {
         node_id: NodeId,
         inputs: &taffy::LayoutInput,
     ) -> Option<taffy::LayoutOutput> {
-        self.node_from_id_mut(node_id)
-            .try_layout_data_mut()?
-            .cache
-            .get(inputs)
+        let layout_data = self.node_from_id_mut(node_id).try_layout_data_mut()?;
+        if inputs.run_mode == RunMode::PerformLayout && layout_data.final_layout_stale {
+            return None;
+        }
+        layout_data.cache.get(inputs)
     }
 
     #[inline]
@@ -761,9 +762,11 @@ impl taffy::CacheTree for LayoutPassState<'_> {
         inputs: &taffy::LayoutInput,
         layout_output: taffy::LayoutOutput,
     ) {
-        self.node_from_id_mut(node_id)
-            .cache_mut()
-            .store(inputs, layout_output);
+        let layout_data = self.node_from_id_mut(node_id).layout_data_mut();
+        if inputs.run_mode == RunMode::PerformLayout {
+            layout_data.final_layout_stale = false;
+        }
+        layout_data.cache.store(inputs, layout_output);
     }
 
     #[inline]
diff --git a/packages/blitz-dom/src/node/element.rs b/packages/blitz-dom/src/node/element.rs
index 23fe95aea..a9e185bec 100644
--- a/packages/blitz-dom/src/node/element.rs
+++ b/packages/blitz-dom/src/node/element.rs
@@ -139,6 +139,10 @@ pub struct ElementData {
 #[derive(Debug, Clone)]
 pub struct LayoutData {
     pub cache: Cache,
+    /// The cached `RunMode::PerformLayout` result is stale: since it was stored, a sizing run
+    /// (`RunMode::ComputeSize`) broke the lines of this node or of an inline root below it at
+    /// another width, and paint draws lines as last broken. Cleared when layout runs again.
+    pub final_layout_stale: bool,
     pub unrounded_layout: Layout,
     pub final_layout: Layout,
     pub scroll_offset: crate::Point<f64>,
@@ -155,6 +159,7 @@ impl LayoutData {
     pub const fn new() -> Self {
         Self {
             cache: Cache::new(),
+            final_layout_stale: false,
             unrounded_layout: Layout::new(),
             final_layout: Layout::new(),
             scroll_offset: crate::Point::ZERO,
