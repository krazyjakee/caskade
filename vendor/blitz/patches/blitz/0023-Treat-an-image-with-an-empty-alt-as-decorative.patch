From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: caskade <caskade@localhost>
Date: Tue, 10 Nov 2026 12:48:01 +0000
Subject: [PATCH] Treat an image with an empty alt as decorative

`<img alt="">` marks an image as decorative, and HTML-AAM maps it as
`role="none"` (presentational), but the AccessKit bridge made every image
an `Image`: a decorative picture inside a labelled element (an avatar
with an `aria-label`, say) came out as a second, nameless image. It now
gets the role `none` and `presentation` already get.
---
 packages/blitz-dom/src/accessibility.rs        |  7 ++++++-
 tests/blitz-tests/tests/accessibility_roles.rs | 12 ++++++++++++
 2 files changed, 18 insertions(+), 1 deletion(-)

diff --git a/packages/blitz-dom/src/accessibility.rs b/packages/blitz-dom/src/accessibility.rs
index 94f74944..6a8daf98 100644
--- a/packages/blitz-dom/src/accessibility.rs
+++ b/packages/blitz-dom/src/accessibility.rs
@@ -826,7 +826,12 @@ fn role_from_element_data(element_data: &ElementData) -> Option<Role> {
         "strong" => Some(Role::Strong),
         "mark" => Some(Role::Mark),
         "time" => Some(Role::Time),
-        "img" => Some(Role::Image),
+        // An empty `alt` marks an image as decorative: it's presentational,
+        // as `role="none"` is (https://www.w3.org/TR/html-aam-1.0/#el-img-empty-alt).
+        "img" => match element_data.attr(local_name!("alt")) {
+            Some("") => Some(Role::GenericContainer),
+            _ => Some(Role::Image),
+        },
         "iframe" => Some(Role::Iframe),
 
         "input" => {
diff --git a/tests/blitz-tests/tests/accessibility_roles.rs b/tests/blitz-tests/tests/accessibility_roles.rs
index 24de01cf..2541eb47 100644
--- a/tests/blitz-tests/tests/accessibility_roles.rs
+++ b/tests/blitz-tests/tests/accessibility_roles.rs
@@ -196,3 +196,15 @@ fn a_semantic_page_has_no_unknown_elements() {
     // this document should map to something an assistive technology can use.
     assert_eq!(unknown_tags(html), vec!["body", "html"]);
 }
+
+#[test]
+fn an_image_with_an_empty_alt_is_decorative() {
+    let html = r#"<html><body>
+        <img id="decorative" alt="" src="data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%2F%3E">
+        <img id="described" alt="A map" src="data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%2F%3E">
+        <img id="unlabelled" src="data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%2F%3E">
+    </body></html>"#;
+    assert_role(html, "decorative", Role::GenericContainer);
+    assert_role(html, "described", Role::Image);
+    assert_role(html, "unlabelled", Role::Image);
+}
