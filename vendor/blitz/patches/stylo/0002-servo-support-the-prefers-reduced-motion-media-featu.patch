From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jake Cattrall <krazyjakee@gmail.com>
Date: Tue, 10 Nov 2026 08:19:11 +0000
Subject: [PATCH] servo: support the prefers-reduced-motion media feature

MediaData::prefers_reduced_motion and Device::set_prefers_reduced_motion
carry the user's setting; @media (prefers-reduced-motion: reduce) and
no-preference evaluate against it, as in the Gecko build.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 style/device/servo.rs         | 16 ++++++++++++++++
 style/servo/media_features.rs | 29 ++++++++++++++++++++++++++++-
 stylo_atoms/static_atoms.txt  |  1 +
 3 files changed, 45 insertions(+), 1 deletion(-)

diff --git a/style/device/servo.rs b/style/device/servo.rs
index 338b73a9b..3fe07f794 100644
--- a/style/device/servo.rs
+++ b/style/device/servo.rs
@@ -79,6 +79,9 @@ pub struct MediaData {
     /// Whether the user prefers light mode or dark mode
     #[ignore_malloc_size_of = "Pure stack type"]
     pub prefers_color_scheme: PrefersColorScheme,
+    /// Whether the user asked for reduced motion (`prefers-reduced-motion: reduce`).
+    #[ignore_malloc_size_of = "Pure stack type"]
+    pub prefers_reduced_motion: bool,
     /// The capabilities of the primary pointer input
     #[ignore_malloc_size_of = "Pure stack type"]
     pub primary_pointer_capabilities: PointerCapabilities,
@@ -325,6 +328,19 @@ impl Device {
         self.extra.media_data.prefers_color_scheme = new_color_scheme;
     }
 
+    /// Set whether the user prefers reduced motion on this [`Device`].
+    ///
+    /// Like [`Self::set_color_scheme`], this does not update any associated
+    /// `Stylist`.
+    pub fn set_prefers_reduced_motion(&mut self, reduced: bool) {
+        self.extra.media_data.prefers_reduced_motion = reduced;
+    }
+
+    /// Whether the user prefers reduced motion.
+    pub fn prefers_reduced_motion(&self) -> bool {
+        self.extra.media_data.prefers_reduced_motion
+    }
+
     /// Returns the color scheme of this [`Device`].
     pub fn color_scheme(&self) -> PrefersColorScheme {
         self.extra.media_data.prefers_color_scheme
diff --git a/style/servo/media_features.rs b/style/servo/media_features.rs
index 14a3e520c..0586c95fe 100644
--- a/style/servo/media_features.rs
+++ b/style/servo/media_features.rs
@@ -63,6 +63,27 @@ fn eval_device_pixel_ratio(context: &Context) -> f32 {
     eval_resolution(context).dppx()
 }
 
+/// Values for the `prefers-reduced-motion` media feature.
+#[derive(Clone, Copy, Debug, FromPrimitive, Parse, PartialEq, ToCss)]
+#[repr(u8)]
+enum PrefersReducedMotion {
+    NoPreference,
+    Reduce,
+}
+
+/// https://drafts.csswg.org/mediaqueries-5/#prefers-reduced-motion
+fn eval_prefers_reduced_motion(
+    context: &Context,
+    query_value: Option<PrefersReducedMotion>,
+) -> bool {
+    let reduced = context.device().prefers_reduced_motion();
+    match query_value {
+        Some(PrefersReducedMotion::NoPreference) => !reduced,
+        Some(PrefersReducedMotion::Reduce) => reduced,
+        None => reduced,
+    }
+}
+
 fn eval_prefers_color_scheme(context: &Context, query_value: Option<PrefersColorScheme>) -> bool {
     match query_value {
         Some(v) => context.device().color_scheme() == v,
@@ -160,7 +181,7 @@ fn eval_aspect_ratio(context: &Context) -> Ratio {
 }
 
 /// A list with all the media features that Servo supports.
-pub static MEDIA_FEATURES: [QueryFeatureDescription; 15] = [
+pub static MEDIA_FEATURES: [QueryFeatureDescription; 16] = [
     feature!(
         atom!("width"),
         AllowsRanges::Yes,
@@ -251,4 +272,10 @@ pub static MEDIA_FEATURES: [QueryFeatureDescription; 15] = [
         keyword_evaluator!(eval_prefers_color_scheme, PrefersColorScheme),
         FeatureFlags::empty(),
     ),
+    feature!(
+        atom!("prefers-reduced-motion"),
+        AllowsRanges::No,
+        keyword_evaluator!(eval_prefers_reduced_motion, PrefersReducedMotion),
+        FeatureFlags::empty(),
+    ),
 ];
diff --git a/stylo_atoms/static_atoms.txt b/stylo_atoms/static_atoms.txt
index ba5267fee..e890c6ebe 100644
--- a/stylo_atoms/static_atoms.txt
+++ b/stylo_atoms/static_atoms.txt
@@ -137,6 +137,7 @@ pointer
 popstate
 postershown
 prefers-color-scheme
+prefers-reduced-motion
 print
 progress
 radio
