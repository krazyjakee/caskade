diff --git a/src/compute/flexbox.rs b/src/compute/flexbox.rs
index a8dbbcf2..92b2c0cb 100644
--- a/src/compute/flexbox.rs
+++ b/src/compute/flexbox.rs
@@ -1607,6 +1607,16 @@ fn determine_container_main_size(
                             style_max.maybe_min(flex_basis_max).or(flex_basis_max).unwrap_or(f32::INFINITY);
 
                         let content_contribution = match (min_main_size, style_preferred, max_main_size) {
+                            // A column container's intrinsic main (block) size is the sum of its items'
+                            // hypothetical main sizes, as Chrome lays it out: each item's flex base
+                            // size clamped by its max and floored by its min (an explicit `min-height`, or the
+                            // automatic minimum, which brings the content back in when `min-height` is `auto`).
+                            // The content beyond that doesn't grow the container, so an item with
+                            // `flex: 1 1 0` and an explicit min doesn't size it from its content.
+                            _ if !constants.is_row => {
+                                item.flex_basis.maybe_min(style_max).max(item.resolved_minimum_main_size) + margin_sum
+                            }
+
                             // If the clamping values are such that max <= min, then we can avoid the expensive step of computing the content size
                             // as we know that the clamping values will override it anyway
                             (min, Some(pref), max) if max <= min || max <= pref => pref.min(max).max(min) + margin_sum,
